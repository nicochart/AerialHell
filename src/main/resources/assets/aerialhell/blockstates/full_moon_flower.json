{
  "multipart": [
    {
      "apply": {
        "model": "aerialhell:block/full_moon_flower"
      },
      "when": {
        "age": "0|1|2|3|4"
      }
    },
    {
      "apply": {
        "model": "aerialhell:block/full_moon_flower_dead"
      },
      "when": {
        "age": "5"
      }
    },
    {
      "apply": {
        "model": "aerialhell:block/full_moon_flower_side"
      },
      "when": {
        "north": "true"
      }
    },
    {
      "apply": {
        "model": "aerialhell:block/full_moon_flower_side",
        "uvlock": true,
        "y": 90
      },
      "when": {
        "east": "true"
      }
    },
    {
      "apply": {
        "model": "aerialhell:block/full_moon_flower_side",
        "uvlock": true,
        "y": 180
      },
      "when": {
        "south": "true"
      }
    },
    {
      "apply": {
        "model": "aerialhell:block/full_moon_flower_side",
        "uvlock": true,
        "y": 270
      },
      "when": {
        "west": "true"
      }
    }
  ]
}